{
  "name": "htm-projection",
  "version": "1.2.0",
  "description": "Reactive HTML with 3 pillars: pattern parser, proxy, and programs. Browser-native API, lightweight reactive projection. Ready for widgets or SPA. A different approach from virtual DOM with fine-grained reactivity — slot-ready even with empty initial state.",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types",
    "README.md"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:types && npm run build:rollup",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir types",
    "build:rollup": "rollup -c rollup.config.js",
    "clean": "rimraf dist types",
    "test": "node tests/basic-smoke.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "htm",
    "html",
    "template",
    "projection",
    "typescript",
    "dom",
    "no-vdom",
    "reactivity",
    "cdn"
  ],
  "author": "Erlangga Satria",
  "license": "MIT",
  "homepage": "https://htmpjs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erlanggasatria-source/HTMP.git"
  },
  "bugs": {
    "url": "https://github.com/erlanggasatria-source/HTMP/issues"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^11.1.6",
    "jsdom": "^30.0.1",
    "rimraf": "^6.0.1",
    "rollup": "^4.10.0",
    "tslib": "^2.6.3",
    "typescript": "~5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
